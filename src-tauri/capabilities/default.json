{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "notification:default",
    "fs:default",
    "http:default",
    "opener:default",
    "opener:allow-open-url"
  ]
}
